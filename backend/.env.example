# Database connection URL (SQLite file path)
DATABASE_URL=sqlite:///./finance_tracker.db

# Market data provider (currently only yfinance is supported)
MARKET_API_PROVIDER=yfinance

# Interval in minutes between automatic market data refreshes (1-1440)
REFRESH_INTERVAL_MINUTES=15

# Finnhub API key for earnings calendar lookup
FINNHUB_API_KEY=your_finnhub_api_key_here

# Plaid API credentials (get from dashboard.plaid.com → Team Settings → Keys)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Chat tools act only for this user id (the app has a single owner).
OWNER_USER_ID=owner

# Chat engine: "rules" (pattern matching over the chat tools).
CHAT_ENGINE=rules

# Auth for POST /api/chat: nginx basic auth forwards the username in this
# header. OWNER_USER_ID must equal that username. On the VM nginx also sends
# AUTH_PROXY_SECRET, which proves the request came through it (see
# docs/chat-api.md); without it, only these client addresses are trusted.
AUTH_USER_HEADER=X-Remote-User
AUTH_TRUSTED_PROXIES=127.0.0.1,::1
# AUTH_PROXY_SECRET=output of: openssl rand -hex 32
AUTH_PROXY_SECRET_HEADER=X-Proxy-Secret
# Local development only (no nginx). Never set on the VM.
# AUTH_DEV_USER=owner

# POST /api/chat limits
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_MAX_BODY_BYTES=8192
CHAT_TIMEOUT_SECONDS=10
CHAT_SESSION_TTL_MINUTES=30
CHAT_HISTORY_LIMIT=20
